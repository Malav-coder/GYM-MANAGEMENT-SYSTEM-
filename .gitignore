# 🔧 TOOL-SPECIFIC FILES
########################################

## Docker
.docker/
.dockerignore

## Git
.git/
.gitignore.bak
.gitmodules

## GitHub Actions
.github/workflows/

## CI/CD pipeline files (local copies)
.circleci/
.gitlab-ci.yml.local
.travis.yml.local

## Formatters and linters cache
.prettierignore.local
.eslintignore.local

########################################
# ⚡ VISUAL STUDIO BUILD OUTPUTS
########################################

## Backup & autosave files
*.backup
*.[Cc]ache
*.log.*
*.log

## Visual Studio generated include files
GeneratedArtifacts/

## MSBuild Binary and Structured Log
*.binlog

## NVidia Nsight GPU debugger configuration file
*.nvuser

## MFractors (Material Design for Xamarin.Android) cache/options directory
.mfractor/

## Local History for Visual Studio Code
.history/
.ionide/

########################################
# 🚫 MUST NOT BE TRACKED
########################################

# These are critical security files - NEVER add them to git
!.gitignore                    # gitignore itself should be tracked
appsettings.Development.json   # Local development config ❌
appsettings.*.json             # Environment-specific configs ❌
.env*                          # Environment files ❌
*.key                          # Private keys ❌
*.p12                          # Certificates ❌
secrets.json                   # Secrets ❌

########################################
# ✅ FILES TO KEEP IN GIT
########################################

# Explicitly include these (using negative patterns)
!.gitignore
!.gitattributes
!.github/
!.vscode/settings.json
!.vscode/launch.json
!appsettings.json              # Base config (no secrets)
!README.md
!LICENSE
