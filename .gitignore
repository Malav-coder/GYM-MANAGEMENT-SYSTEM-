########################################
# ⚠️  CRITICAL: SENSITIVE FILES - NEVER PUSH
########################################

## Configuration files with secrets and credentials
appsettings.Development.json
appsettings.Local.json
appsettings.*.json
!appsettings.json
appsettings.Staging.json
appsettings.Production.json

## Environment variable files
.env
.env.local
.env.*.local
.env.*.js
.env.production.local
.env.development.local
.env.test.local

## Database connection strings and credentials
Migrations/*.designer.cs # Contains seeded passwords
*.db-shm
*.db-wal

