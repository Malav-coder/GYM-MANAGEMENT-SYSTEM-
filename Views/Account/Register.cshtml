@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
    Layout = null; // Full-page auth layout
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register - PowerFit GMS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="auth-page" style="align-items: flex-start; overflow-y: auto; padding: 32px 16px;">
    <div class="auth-card" style="max-width: 500px; margin: auto;">
        <!-- Logo -->
        <div class="auth-logo">
            <i class="bi bi-lightning-charge-fill" style="color:#fff;font-size:26px;"></i>
        </div>
        <h1 class="auth-title">Create Account</h1>
        <p class="auth-subtitle">Join PowerFit and start your fitness journey today</p>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" style="display:none;"></div>

        <form asp-action="Register" method="post">
            <div class="mb-3">
                <label asp-for="Name" class="form-label"><i class="bi bi-person me-1"></i>Full Name</label>
                <input asp-for="Name" class="form-control" placeholder="John Doe" />
                <span asp-validation-for="Name" class="text-danger" style="font-size:0.78rem;"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Phone" class="form-label"><i class="bi bi-telephone me-1"></i>Phone (10 digits)</label>
                <input asp-for="Phone" class="form-control" placeholder="9876543210" />
                <span asp-validation-for="Phone" class="text-danger" style="font-size:0.78rem;"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"><i class="bi bi-envelope me-1"></i>Email Address</label>
                <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                <span asp-validation-for="Email" class="text-danger" style="font-size:0.78rem;"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Gender" class="form-label"><i class="bi bi-gender-ambiguous me-1"></i>Gender</label>
                <select asp-for="Gender" class="form-select">
                    <option value="">Select gender...</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"><i class="bi bi-lock me-1"></i>Password (min 6 chars)</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-danger" style="font-size:0.78rem;"></span>
            </div>
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label"><i class="bi bi-shield-lock me-1"></i>Confirm Password</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" />
                <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:0.78rem;"></span>
            </div>
            <button type="submit" class="btn btn-success w-100 btn-lg mb-4">
                <i class="bi bi-person-plus-fill"></i> Create Account
            </button>
        </form>

        <div style="text-align:center;border-top:1px solid var(--border);padding-top:20px;">
            <p style="color:var(--text-secondary);font-size:0.87rem;margin:0;">
                Already a member?
                <a asp-action="Login" style="color:var(--accent);font-weight:600;">Sign in &rarr;</a>
            </p>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
</body>
</html>
