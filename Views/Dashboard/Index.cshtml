@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<!-- Page Header -->
<div class="section-header mb-4">
    <div>
        <h1 class="page-title mb-1"><i class="bi bi-grid-1x2-fill me-2" style="color:var(--accent)"></i>Dashboard</h1>
        <p class="page-subtitle">Welcome back, Admin &mdash; here's your gym at a glance</p>
    </div>
    <span class="card-chip"><i class="bi bi-circle-fill" style="color:var(--accent-green);font-size:8px;"></i> Live Data</span>
</div>

<!-- ── Stat Cards ── -->
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="card stat-card card-accent-blue p-0">
            <div class="card-body">
                <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
                <div class="stat-value">@Model.TotalMembers</div>
                <div class="stat-label">Total Members</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card stat-card card-accent-green p-0">
            <div class="card-body">
                <div class="stat-icon"><i class="bi bi-patch-check-fill"></i></div>
                <div class="stat-value">@Model.ActiveMemberships</div>
                <div class="stat-label">Active Memberships</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card stat-card card-accent-red p-0">
            <div class="card-body">
                <div class="stat-icon"><i class="bi bi-clock-history"></i></div>
                <div class="stat-value">@Model.ExpiredMemberships</div>
                <div class="stat-label">Expired</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card stat-card card-accent-yellow p-0">
            <div class="card-body">
                <div class="stat-icon"><i class="bi bi-x-circle-fill"></i></div>
                <div class="stat-value">@Model.CancelledMemberships</div>
                <div class="stat-label">Cancelled</div>
            </div>
        </div>
    </div>
</div>

<!-- ── Charts Row ── -->
<div class="row g-3 mb-4">
    <!-- Revenue Card -->
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-body">
                <div class="card-title"><i class="bi bi-currency-rupee me-1"></i>Total Revenue</div>
                <div class="mb-2" style="font-size:2.6rem;font-weight:800;letter-spacing:-0.04em;color:var(--accent-green);">
                    ₹@Model.TotalRevenue.ToString("N2")
                </div>
                <p class="mb-3" style="font-size:0.8rem;color:var(--text-muted);">Lifetime revenue from all subscriptions & renewals</p>
                <div class="chart-container" style="height:170px;">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Membership Donut -->
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-body d-flex flex-column align-items-center">
                <div class="card-title w-100"><i class="bi bi-pie-chart-fill me-1"></i>Membership Breakdown</div>
                <div class="chart-container" style="height:200px;width:200px;">
                    <canvas id="membershipChart"></canvas>
                </div>
                <div class="mt-3 d-flex gap-3 flex-wrap justify-content-center text-light" style="font-size:0.78rem;">
                    <span><span style="color:var(--accent-green);">●</span> Active (@Model.ActiveMemberships)</span>
                    <span><span style="color:var(--accent-red);">●</span> Expired (@Model.ExpiredMemberships)</span>
                    <span><span style="color:var(--accent-yellow);">●</span> Cancelled (@Model.CancelledMemberships)</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="card-title"><i class="bi bi-bar-chart-fill me-1"></i>Quick Stats</div>
                <div class="d-flex flex-column gap-3 mt-2">
                    <div>
                        <div class="d-flex justify-content-between mb-1" style="font-size:0.8rem;">
                            <span class="text-secondary">Active Rate</span>
                            @{ var activeRate = Model.TotalMembers > 0 ? (Model.ActiveMemberships * 100 / Model.TotalMembers) : 0; }
                            <span style="color:var(--accent-green);font-weight:600;">@activeRate%</span>
                        </div>
                        <div class="progress">
                            <div class="progress-bar bg-success" style="width:@activeRate%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="d-flex justify-content-between mb-1" style="font-size:0.8rem;">
                            <span class="text-secondary">Expired Rate</span>
                            @{ var expiredRate = Model.TotalMembers > 0 ? (Model.ExpiredMemberships * 100 / Model.TotalMembers) : 0; }
                            <span style="color:var(--accent-red);font-weight:600;">@expiredRate%</span>
                        </div>
                        <div class="progress">
                            <div class="progress-bar bg-danger" style="width:@expiredRate%;background:linear-gradient(90deg,var(--accent-red),#ff8888) !important;"></div>
                        </div>
                    </div>
                    <div>
                        <div class="d-flex justify-content-between mb-1" style="font-size:0.8rem;">
                            <span class="text-secondary">Cancelled Rate</span>
                            @{ var cancelRate = Model.TotalMembers > 0 ? (Model.CancelledMemberships * 100 / Model.TotalMembers) : 0; }
                            <span style="color:var(--accent-yellow);font-weight:600;">@cancelRate%</span>
                        </div>
                        <div class="progress">
                            <div class="progress-bar" style="width:@cancelRate%;background:linear-gradient(90deg,var(--accent-yellow),#ffdd88) !important;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── Expiring This Week ── -->
<div class="card">
    <div class="card-body">
        <div class="card-title"><i class="bi bi-exclamation-triangle-fill me-1" style="color:var(--accent-yellow)"></i>Expiring This Week</div>
        @if (Model.ExpiringThisWeek.Any())
        {
            <div class="table-container mt-2">
                <table class="table">
                    <thead>
                        <tr>
                            <th><i class="bi bi-person me-1"></i>Member Name</th>
                            <th><i class="bi bi-collection me-1"></i>Plan</th>
                            <th><i class="bi bi-calendar-x me-1"></i>End Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var membership in Model.ExpiringThisWeek)
                        {
                            var daysLeft = (membership.EndDate - DateTime.Today).Days;
                            <tr>
                                <td><strong>@membership.User.Name</strong></td>
                                <td><span class="badge bg-primary">@membership.Plan.PlanName</span></td>
                                <td>@membership.EndDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (daysLeft <= 2)
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-exclamation-circle me-1"></i>@daysLeft day(s) left</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning"><i class="bi bi-clock me-1"></i>@daysLeft days left</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="d-flex align-items-center gap-3 mt-2" style="color:var(--accent-green);">
                <i class="bi bi-check-circle-fill" style="font-size:1.5rem;"></i>
                <span>No memberships expiring this week. All good!</span>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        Chart.defaults.color = '#8892b0';
        Chart.defaults.borderColor = 'rgba(255,255,255,0.04)';
        Chart.defaults.font.family = 'Inter, sans-serif';

        // Revenue Bar Chart
        const revenueCtx = document.getElementById('revenueChart').getContext('2d');
        const revenueGrad = revenueCtx.createLinearGradient(0, 0, 0, 170);
        revenueGrad.addColorStop(0, 'rgba(57,255,126,0.4)');
        revenueGrad.addColorStop(1, 'rgba(57,255,126,0.01)');

        new Chart(revenueCtx, {
            type: 'bar',
            data: {
                labels: ['Active', 'Expired', 'Cancelled', 'Total'],
                datasets: [{
                    label: 'Revenue (₹)',
                    data: [@Model.ActiveMemberships * 100, @Model.ExpiredMemberships * 80, @Model.CancelledMemberships * 40, @Model.TotalRevenue / 100],
                    backgroundColor: [
                        'rgba(57,255,126,0.6)', 'rgba(255,78,106,0.6)',
                        'rgba(255,201,71,0.6)', 'rgba(0,200,255,0.6)'
                    ],
                    borderRadius: 8,
                    borderSkipped: false,
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false }, ticks: { font: { size: 10 } } },
                    y: { grid: { color: 'rgba(255,255,255,0.04)' }, ticks: { font: { size: 10 } } }
                },
                animation: { duration: 1000, easing: 'easeOutQuart' }
            }
        });

        // Membership Donut Chart
        const donutCtx = document.getElementById('membershipChart').getContext('2d');
        new Chart(donutCtx, {
            type: 'doughnut',
            data: {
                labels: ['Active', 'Expired', 'Cancelled'],
                datasets: [{
                    data: [@Model.ActiveMemberships, @Model.ExpiredMemberships, @Model.CancelledMemberships],
                    backgroundColor: ['rgba(57,255,126,0.75)', 'rgba(255,78,106,0.75)', 'rgba(255,201,71,0.75)'],
                    borderColor: ['#0d0f14'],
                    borderWidth: 3,
                    hoverOffset: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '72%',
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: ctx => ` ${ctx.label}: ${ctx.parsed}`
                        }
                    }
                },
                animation: { animateRotate: true, duration: 1200, easing: 'easeOutQuart' }
            }
        });
    </script>
}
