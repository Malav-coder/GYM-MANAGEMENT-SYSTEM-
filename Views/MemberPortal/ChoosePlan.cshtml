@model List<Plan>
@{
    ViewData["Title"] = "Choose Your Plan";
    var features = new[] { "Unlimited Gym Access", "Locker Room Access", "Group Classes", "Trainer Consultation", "Progress Tracking" };
}

<div class="section-header mb-4">
    <div>
        <h1 class="page-title mb-1"><i class="bi bi-stars me-2" style="color:var(--accent)"></i>Choose Your Plan</h1>
        <p class="page-subtitle">Select the perfect membership to power your fitness journey</p>
    </div>
</div>

<div class="row g-4 mb-4 justify-content-center">
    @for (int i = 0; i < Model.Count; i++)
    {
        var plan = Model[i];
        bool isFeatured = i == Model.Count / 2 || (Model.Count == 1);
        var planFeatures = features.Take(2 + (plan.DurationMonths / 2)).ToArray();
        <div class="col-md-6 col-lg-3">
            <div class="pricing-card @(isFeatured ? "featured" : "") h-100">
                @if (isFeatured)
                {
                    <div class="pricing-badge"><i class="bi bi-star-fill me-1"></i>Most Popular</div>
                }
                <div class="pricing-name">@plan.PlanName</div>
                <div class="pricing-duration">
                    <i class="bi bi-calendar3 me-1"></i>@plan.DurationMonths Month@(plan.DurationMonths > 1 ? "s" : "")
                </div>
                <div class="pricing-price">
                    <sup>₹</sup>@((int)plan.Price)
                    @if (plan.Price % 1 != 0)
                    {
                        <small style="font-size:1rem;">.@((int)(plan.Price % 1 * 100))</small>
                    }
                </div>
                <div style="font-size:0.78rem;color:var(--text-muted);margin-bottom:16px;">per @plan.DurationMonths month@(plan.DurationMonths > 1 ? "s" : "")</div>

                <ul class="pricing-features">
                    @foreach (var feature in planFeatures)
                    {
                        <li><i class="bi bi-check-circle-fill"></i>@feature</li>
                    }
                </ul>

                <a asp-controller="Payment" asp-action="Checkout"
                   asp-route-planId="@plan.Id"
                   asp-route-paymentType="Subscription"
                   class="btn @(isFeatured ? "btn-primary" : "btn-outline-primary") w-100 btn-lg">
                    <i class="bi bi-lightning-charge-fill"></i> Get Started
                </a>
            </div>
        </div>
    }
</div>

<!-- Trust badges -->
<div class="d-flex justify-content-center gap-4 flex-wrap" style="padding:20px 0;border-top:1px solid var(--border);">
    <div class="security-badge"><i class="bi bi-shield-lock-fill"></i> 100% Secure Payment</div>
    <div class="security-badge"><i class="bi bi-arrow-counterclockwise"></i> Cancel Anytime</div>
    <div class="security-badge"><i class="bi bi-headset"></i> 24/7 Support</div>
    <div class="security-badge"><i class="bi bi-patch-check-fill"></i> Certified Trainers</div>
</div>
