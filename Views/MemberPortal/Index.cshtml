@model MemberDashboardViewModel
@{
    ViewData["Title"] = "My Membership";
    int progressPercent = 0;
    bool isExpiringSoon = false;
    if (Model.ActiveMembership != null)
    {
        var totalDays = (Model.ActiveMembership.EndDate - Model.ActiveMembership.StartDate).Days;
        var daysElapsed = (DateTime.Today - Model.ActiveMembership.StartDate).Days;
        progressPercent = totalDays > 0 ? Math.Min(100, (daysElapsed * 100 / totalDays)) : 0;
        isExpiringSoon = Model.DaysRemaining <= 7;
    }
}

<!-- Page Header -->
<div class="section-header mb-4">
    <div>
        <h1 class="page-title mb-1"><i class="bi bi-person-vcard-fill me-2" style="color:var(--accent)"></i>My Membership</h1>
        <p class="page-subtitle">Track your fitness journey and subscription</p>
    </div>
</div>

<!-- Frozen Warning -->
@if (Model.User.IsFrozen)
{
    <div class="alert alert-danger mb-4" role="alert">
        <i class="bi bi-snow2" style="font-size:1.2rem;"></i>
        <div>
            <strong>Account Frozen</strong> — Your account has been frozen by the administrator. Please contact support.
        </div>
    </div>
}

@if (Model.ActiveMembership != null)
{
    <!-- Active Membership Card -->
    <div class="membership-card mb-4">
        <div class="row align-items-center g-4">
            <div class="col-md-5">
                <div class="card-chip mb-3">
                    <i class="bi bi-patch-check-fill"></i> Active Plan
                </div>
                <h2 style="font-size:1.8rem;font-weight:800;margin-bottom:6px;">@Model.ActiveMembership.Plan.PlanName</h2>
                <p style="color:var(--text-secondary);font-size:0.85rem;margin-bottom:20px;">
                    <i class="bi bi-calendar3 me-1"></i>
                    @Model.ActiveMembership.StartDate.ToString("dd MMM yyyy") &rarr; @Model.ActiveMembership.EndDate.ToString("dd MMM yyyy")
                </p>
                <div class="d-flex align-items-baseline gap-2 mb-1">
                    <div class="days-remaining">@Model.DaysRemaining</div>
                    <div class="days-label">days remaining</div>
                </div>
                <div class="mb-3">
                    @if (isExpiringSoon)
                    {
                        <span class="badge bg-warning"><i class="bi bi-exclamation-triangle-fill me-1"></i>Expiring Soon — Act Now!</span>
                    }
                    else
                    {
                        <span class="badge bg-success"><i class="bi bi-patch-check me-1"></i>Active &amp; Healthy</span>
                    }
                </div>

                @if (!Model.User.IsFrozen)
                {
                    <div class="d-flex gap-3 flex-wrap mt-4">
                        @if (Model.DaysRemaining <= 5 || Model.ActiveMembership.Status == "Expired")
                        {
                            <a asp-action="Renew" class="btn btn-primary btn-lg">
                                <i class="bi bi-arrow-repeat"></i> Renew Plan
                            </a>
                        }
                        else
                        {
                            <span style="font-size:0.8rem;color:var(--text-muted);display:flex;align-items:center;">
                                <i class="bi bi-info-circle me-1"></i> You can renew or upgrade your plan within 5 days of expiration.
                            </span>
                        }
                        <a asp-action="Cancel" class="btn btn-outline-danger">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                    </div>
                }
            </div>

            <div class="col-md-7">
                <div style="padding:0 20px;">
                    <div class="d-flex justify-content-between mb-2" style="font-size:0.82rem;">
                        <span style="color:var(--text-secondary);">Progress</span>
                        <span style="font-weight:700;color:var(--accent);">@progressPercent% elapsed</span>
                    </div>
                    <div class="progress progress-bar-thick mb-4">
                        <div class="progress-bar @(isExpiringSoon ? "bg-warning" : "bg-success")"
                             role="progressbar"
                             style="width:@progressPercent%"
                             aria-valuenow="@progressPercent" aria-valuemin="0" aria-valuemax="100">
                        </div>
                    </div>

                    <!-- Stats Row -->
                    <div class="row g-3">
                        <div class="col-4">
                            <div style="text-align:center;padding:16px;background:rgba(255,255,255,0.03);border-radius:10px;border:1px solid var(--border);">
                                <div style="font-size:1.4rem;font-weight:800;color:var(--accent);">@((Model.ActiveMembership.EndDate - Model.ActiveMembership.StartDate).Days)</div>
                                <div style="font-size:0.72rem;color:var(--text-muted);margin-top:2px;">Total Days</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div style="text-align:center;padding:16px;background:rgba(255,255,255,0.03);border-radius:10px;border:1px solid var(--border);">
                                <div style="font-size:1.4rem;font-weight:800;color:var(--accent-green);">@Model.DaysRemaining</div>
                                <div style="font-size:0.72rem;color:var(--text-muted);margin-top:2px;">Remaining</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div style="text-align:center;padding:16px;background:rgba(255,255,255,0.03);border-radius:10px;border:1px solid var(--border);">
                                <div style="font-size:1.4rem;font-weight:800;color:var(--accent-yellow);">@progressPercent%</div>
                                <div style="font-size:0.72rem;color:var(--text-muted);margin-top:2px;">Used</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- No Active Plan CTA -->
    <div class="card mb-4" style="text-align:center;padding:48px 24px;border:1px dashed var(--border-accent);">
        <i class="bi bi-stars" style="font-size:3rem;color:var(--accent);margin-bottom:16px;display:block;"></i>
        <h3 style="font-weight:800;margin-bottom:8px;">No Active Membership</h3>
        <p style="color:var(--text-secondary);margin-bottom:24px;">Start your fitness journey today. Choose a plan that fits your goals.</p>
        <div>
            <a asp-action="ChoosePlan" class="btn btn-primary btn-lg">
                <i class="bi bi-stars"></i> Explore Plans
            </a>
        </div>
    </div>
}

<!-- Recent Payments -->
<div class="card">
    <div class="card-body">
        <div class="card-title"><i class="bi bi-receipt me-1"></i>Payment History</div>
        @if (Model.RecentPayments.Any())
        {
            <div class="table-container mt-2" style="max-height: 300px; overflow-y: auto;">
                <table class="table">
                    <thead style="position: sticky; top: 0; background-color: #0f0f0f; z-index: 1;">
                        <tr>
                            <th>Type</th>
                            <th>Amount</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payment in Model.RecentPayments)
                        {
                            <tr>
                                <td>
                                    @if (payment.Type == "Renewal")
                                    {
                                        <span class="badge bg-primary"><i class="bi bi-arrow-repeat me-1"></i>@payment.Type</span>
                                    }
                                    else if (payment.Type == "CancellationFee")
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>@payment.Type</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@payment.Type</span>
                                    }
                                </td>
                                <td style="font-weight:700;color:var(--accent-green);">₹@payment.Amount.ToString("N2")</td>
                                <td style="color:var(--text-secondary);">@payment.PaidAt.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div style="color:var(--text-muted);padding:20px 0;font-size:0.85rem;">
                <i class="bi bi-inbox me-2"></i>No payment history yet.
            </div>
        }
    </div>
</div>
