@{
    ViewData["Title"] = "Payment Successful";
}

<div style="min-height:60vh;display:flex;align-items:center;justify-content:center;padding:40px 16px;">
    <div style="max-width:500px;width:100%;text-align:center;">
        <!-- Animated Success Icon -->
        <div class="success-icon">
            <i class="bi bi-check-lg" style="color:var(--accent-green);filter:drop-shadow(0 0 12px var(--accent-green));"></i>
        </div>

        <h1 style="font-size:2rem;font-weight:800;margin-bottom:8px;">Payment Successful!</h1>
        <p style="color:var(--text-secondary);margin-bottom:32px;">
            Your membership has been activated. Welcome to PowerFit! 💪
        </p>

        <!-- Membership Details -->
        <div class="success-details-card mb-4">
            <div class="detail-row">
                <span class="label"><i class="bi bi-collection me-1"></i>Plan</span>
                <span class="value" style="color:var(--accent);">@ViewBag.PlanName</span>
            </div>
            <div class="detail-row">
                <span class="label"><i class="bi bi-calendar-check me-1"></i>Start Date</span>
                <span class="value">@ViewBag.StartDate</span>
            </div>
            <div class="detail-row">
                <span class="label"><i class="bi bi-calendar-x me-1"></i>End Date</span>
                <span class="value">@ViewBag.EndDate</span>
            </div>
            <div class="detail-row">
                <span class="label"><i class="bi bi-currency-rupee me-1"></i>Amount Paid</span>
                <span class="value" style="color:var(--accent-green);font-size:1.1rem;">₹@ViewBag.Amount</span>
            </div>
        </div>

        <!-- CTA Buttons -->
        <div class="d-flex gap-3 justify-content-center flex-wrap">
            <a asp-controller="MemberPortal" asp-action="Index" class="btn btn-primary btn-lg">
                <i class="bi bi-person-vcard-fill"></i> Go to My Dashboard
            </a>
        </div>

        <p style="color:var(--text-muted);font-size:0.76rem;margin-top:20px;">
            <i class="bi bi-envelope me-1"></i>A confirmation has been recorded to your account.
        </p>
    </div>
</div>
