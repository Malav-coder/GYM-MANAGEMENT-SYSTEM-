@model Plan
@{
    ViewData["Title"] = "Edit Plan";
}

<div class="section-header mb-4">
    <div>
        <h1 class="page-title mb-1"><i class="bi bi-pencil-fill me-2" style="color:var(--accent)"></i>Edit Plan</h1>
        <p class="page-subtitle">Modify the details of "<strong>@Model.PlanName</strong>"</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back to Plans
    </a>
</div>

<div class="row justify-content-start">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="IsActive" />

                    <div class="mb-4">
                        <label asp-for="PlanName" class="form-label"><i class="bi bi-tag me-1"></i>Plan Name</label>
                        <input asp-for="PlanName" class="form-control" placeholder="e.g. Gold Monthly" />
                        <span asp-validation-for="PlanName" class="text-danger" style="font-size:0.78rem;"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="DurationMonths" class="form-label"><i class="bi bi-calendar3 me-1"></i>Duration (Months)</label>
                        <input asp-for="DurationMonths" type="number" class="form-control" placeholder="1" min="1" max="24" />
                        <span asp-validation-for="DurationMonths" class="text-danger" style="font-size:0.78rem;"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Price" class="form-label"><i class="bi bi-currency-rupee me-1"></i>Price (₹)</label>
                        <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="999.00" min="0" />
                        <span asp-validation-for="Price" class="text-danger" style="font-size:0.78rem;"></span>
                    </div>
                    <div class="d-flex gap-3 pt-2">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-check-circle-fill"></i> Save Changes
                        </button>
                        <a asp-action="Index" class="btn btn-secondary btn-lg">
                            <i class="bi bi-x"></i> Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
