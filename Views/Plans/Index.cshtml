@model List<Plan>
@{
    ViewData["Title"] = "Plans";
}

<div class="section-header mb-4">
    <div>
        <h1 class="page-title mb-1"><i class="bi bi-collection-fill me-2" style="color:var(--accent)"></i>Membership Plans</h1>
        <p class="page-subtitle">Manage all gym subscription plans</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add New Plan
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-container">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th><i class="bi bi-tag me-1"></i>Plan Name</th>
                        <th><i class="bi bi-calendar3 me-1"></i>Duration</th>
                        <th><i class="bi bi-currency-rupee me-1"></i>Price</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var plan in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width:34px;height:34px;border-radius:8px;background:rgba(0,200,255,0.08);border:1px solid var(--border-accent);display:flex;align-items:center;justify-content:center;color:var(--accent);font-size:0.9rem;">
                                        <i class="bi bi-stars"></i>
                                    </div>
                                    <span style="font-weight:600;">@plan.PlanName</span>
                                </div>
                            </td>
                            <td>
                                <span style="color:var(--text-secondary);">@plan.DurationMonths Month@(plan.DurationMonths > 1 ? "s" : "")</span>
                            </td>
                            <td style="font-weight:700;color:var(--accent-green);">₹@plan.Price.ToString("N2")</td>
                            <td>
                                @if (plan.IsActive)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-dash-circle me-1"></i>Inactive</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@plan.Id" class="btn btn-sm" style="background:rgba(148,163,184,0.1);color:#94a3b8;border:1px solid rgba(148,163,184,0.25);">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <form asp-action="Toggle" asp-route-id="@plan.Id" method="post" class="d-inline">
                                        @if (plan.IsActive)
                                        {
                                            <button type="submit" class="btn btn-sm" style="background:rgba(180,80,80,0.1);color:#c87878;border:1px solid rgba(180,80,80,0.25);">
                                                <i class="bi bi-toggle-on"></i> Deactivate
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm" style="background:rgba(57,180,100,0.1);color:#5db87a;border:1px solid rgba(57,180,100,0.25);">
                                                <i class="bi bi-toggle-off"></i> Activate
                                            </button>
                                        }
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.Any())
        {
            <div class="text-center py-5" style="color:var(--text-muted);">
                <i class="bi bi-collection" style="font-size:2.5rem;margin-bottom:12px;display:block;"></i>
                <p>No plans found. Add your first plan!</p>
            </div>
        }
    </div>
</div>
