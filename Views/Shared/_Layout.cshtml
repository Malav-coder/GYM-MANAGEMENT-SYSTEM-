<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PowerFit GMS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

@{
    var isLoggedIn = Context.Session.GetString("IsLoggedIn") == "true";
    var role = Context.Session.GetString("Role");
    var userName = Context.Session.GetString("UserName") ?? "User";
    var userInitial = userName.Length > 0 ? userName[0].ToString().ToUpper() : "U";
    var currentPath = Context.Request.Path.Value ?? "";
}

@if (isLoggedIn)
{
    <!-- Mobile toggle button -->
    <button class="mobile-toggle" id="sidebarToggle" aria-label="Toggle Sidebar">
        <i class="bi bi-list"></i>
    </button>

    <!-- Sidebar overlay for mobile -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="app-wrapper">
        <!-- ══ SIDEBAR ══ -->
        <aside class="sidebar" id="sidebar">
            <!-- Brand -->
            <a class="sidebar-brand" href="/">
                <div class="brand-icon">
                    <i class="bi bi-lightning-charge-fill" style="color:#fff;"></i>
                </div>
                <div class="brand-text">Power<span>Fit</span></div>
            </a>

            @if (role == "Admin")
            {
                <!-- Admin Navigation -->
                <div class="sidebar-section">
                    <div class="sidebar-section-label">Main</div>
                    <ul class="sidebar-nav">
                        <li class="nav-item">
                            <a class="nav-link @(currentPath.StartsWith("/Dashboard") || currentPath == "/" ? "active" : "")"
                               asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-grid-1x2-fill"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentPath.StartsWith("/Members") ? "active" : "")"
                               asp-controller="Members" asp-action="Index">
                                <i class="bi bi-people-fill"></i>
                                <span>Members</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentPath.StartsWith("/Plans") ? "active" : "")"
                               asp-controller="Plans" asp-action="Index">
                                <i class="bi bi-collection-fill"></i>
                                <span>Plans</span>
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="sidebar-section">
                    <div class="sidebar-section-label">System</div>
                    <ul class="sidebar-nav">
                        <li class="nav-item">
                            <span class="nav-link">
                                <i class="bi bi-shield-fill-check" style="color:var(--accent-yellow)"></i>
                                <span><span class="badge bg-warning" style="font-size:0.7rem;">Admin</span></span>
                            </span>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <!-- Member Navigation -->
                <div class="sidebar-section">
                    <div class="sidebar-section-label">My Account</div>
                    <ul class="sidebar-nav">
                        <li class="nav-item">
                            <a class="nav-link @(currentPath.StartsWith("/MemberPortal") ? "active" : "")"
                               asp-controller="MemberPortal" asp-action="Index">
                                <i class="bi bi-person-vcard-fill"></i>
                                <span>My Membership</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentPath.StartsWith("/MemberPortal/ChoosePlan") ? "active" : "")"
                               asp-controller="MemberPortal" asp-action="ChoosePlan">
                                <i class="bi bi-stars"></i>
                                <span>Upgrade Plan</span>
                            </a>
                        </li>
                    </ul>
                </div>
            }

            <!-- Sidebar Footer -->
            <div class="sidebar-footer">
                <div class="sidebar-user">
                    <div class="user-avatar">@userInitial</div>
                    <div class="user-info">
                        <div class="user-name">@userName</div>
                        <div class="user-role">@(role == "Admin" ? "Administrator" : "Member")</div>
                    </div>
                </div>
                <a asp-controller="Account" asp-action="Logout" class="sidebar-logout">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Logout</span>
                </a>
            </div>
        </aside>

        <!-- ══ MAIN CONTENT ══ -->
        <div class="main-content">
            <div class="page-container">
                <main role="main">
                    @RenderBody()
                </main>
            </div>
            <footer class="app-footer">
                <span>PowerFit GMS &copy; 2026</span>
                <span style="color:var(--text-muted);">Premium Fitness Management</span>
            </footer>
        </div>
    </div>
}
else
{
    <!-- Guest layout (Login/Register) — no sidebar -->
    <main role="main">
        @RenderBody()
    </main>
}

<!-- Hidden TempData carriers for SweetAlert2 -->
@if (TempData["Success"] != null)
{
    <span id="toast-success" data-msg="@TempData["Success"]" hidden></span>
}
@if (TempData["Error"] != null)
{
    <span id="toast-error" data-msg="@TempData["Error"]" hidden></span>
}

<!-- Scripts -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    // SweetAlert2 Toast Notifications
    const Toast = Swal.mixin({
        toast: true,
        position: 'top-end',
        showConfirmButton: false,
        timer: 3500,
        timerProgressBar: true,
        background: 'var(--bg-card)',
        color: 'var(--text-primary)',
        iconColor: 'var(--accent-green)',
        didOpen: (toast) => {
            toast.addEventListener('mouseenter', Swal.stopTimer);
            toast.addEventListener('mouseleave', Swal.resumeTimer);
        }
    });

    const successEl = document.getElementById('toast-success');
    const errorEl = document.getElementById('toast-error');

    if (successEl) {
        Toast.fire({ icon: 'success', title: successEl.dataset.msg });
    }
    if (errorEl) {
        Toast.fire({
            icon: 'error',
            title: errorEl.dataset.msg,
            iconColor: 'var(--accent-red)'
        });
    }

    // Mobile sidebar toggle
    const sidebar = document.getElementById('sidebar');
    const toggleBtn = document.getElementById('sidebarToggle');
    const overlay = document.getElementById('sidebarOverlay');

    if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
            sidebar.classList.toggle('open');
            overlay?.classList.toggle('open');
        });
        overlay?.addEventListener('click', () => {
            sidebar.classList.remove('open');
            overlay.classList.remove('open');
        });
    }
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
